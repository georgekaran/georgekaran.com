{
  "tabWidth": 2,
  "printWidth": 120,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/*.md",
    "**/*.mdx",
    "content/**",
    "next-env.d.ts"
  ]
}
